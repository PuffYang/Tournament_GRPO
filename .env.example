# Copy this file to `.env`, fill in real values, and source it before running start.sh:
#   set -a && source .env && set +a
#
# All variables here are read by start.sh / tournament_grpo_reward.py /
# verl/verl/tools/tournament_grpo_search_tools.py.

# ---------------------------------------------------------------------------
# Local base model (any Qwen2.5-7B-Instruct compatible checkpoint).
# ---------------------------------------------------------------------------
MODEL_PATH=/path/to/Qwen2.5-7B-Instruct

# ---------------------------------------------------------------------------
# Web search backend.
# The endpoint must accept POST {search_engine, search_query, query_rewrite}
# and return JSON containing `search_result: [{title, url, snippet, ...}]`.
# ---------------------------------------------------------------------------
WEB_SEARCH_API_URL=https://your-search-backend.example.com/v1/web_search
WEB_SEARCH_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Optional: Jina Reader for webpage extraction (https://r.jina.ai).
# Leave blank to use the public anonymous tier.
# ---------------------------------------------------------------------------
JINA_API_KEY=
JINA_RATE_LIMIT_RPM=20
# Optional HTTP(S) proxy (host:port). Leave blank to disable.
JINA_READER_PROXY=

# ---------------------------------------------------------------------------
# Tournament judge model (any OpenAI-compatible /v1/chat/completions endpoint).
# ---------------------------------------------------------------------------
JUDGE_HOST=localhost
JUDGE_PORT=8000
TOURNAMENT_JUDGE_API_URL=http://${JUDGE_HOST}:${JUDGE_PORT}/v1/chat/completions
TOURNAMENT_JUDGE_API_KEY=EMPTY
TOURNAMENT_JUDGE_MODEL_NAME=Qwen2.5-72B-Instruct

# ---------------------------------------------------------------------------
# Optional: Weights & Biases logging. Leave blank to log to console only.
# ---------------------------------------------------------------------------
WANDB_API_KEY=
# Set to '["console","wandb"]' to enable W&B.
TRAINER_LOGGER=["console"]

# ---------------------------------------------------------------------------
# Hardware.
# ---------------------------------------------------------------------------
N_GPUS_PER_NODE=8
